# =============================================
# ClipScheduler Backend - Environment Variables Example
# =============================================

# --- Application ---
APP_NAME=ClipScheduler
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ---
JWT_ACCESS_SECRET_KEY=your_secure_random_access_secret_here
JWT_REFRESH_SECRET_KEY=your_secure_random_refresh_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipscheduler

# --- Frontend URL ---
FRONTEND_LOCAL_URL=http://localhost:3000
FRONTEND_HOSTED_URL=

# --- Cloudflare R2 / S3 Storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=clipscheduler-videos
R2_PUBLIC_URL=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@clipscheduler.io

# --- Social Media Platforms ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/accounts/oauth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
GCP_PROJECT_NUMBER=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/accounts/oauth/instagram/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/accounts/oauth/tiktok/callback

THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

X_API_KEY=
X_API_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/accounts/oauth/x/callback

# --- Gemini AI & Stock APIs ---
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_CANDIDATE_MODEL=gemini-2.0-flash-lite
GEMINI_API_KEY=
PEXELS_API_KEY=
