# =============================================
# ClipScheduler Backend - Environment Variables Example
# =============================================

# --- Application ---
APP_NAME=ClipScheduler
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR_NGROK_DOMAIN.ngrok-free.dev

# --- JWT Secrets ---
JWT_ACCESS_SECRET_KEY=your_secure_random_access_secret_here
JWT_REFRESH_SECRET_KEY=your_secure_random_refresh_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL / Neon) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipscheduler

# --- Frontend URL ---
FRONTEND_LOCAL_URL=http://localhost:3000
FRONTEND_HOSTED_URL=https://YOUR_NGROK_DOMAIN.ngrok-free.dev

# --- Cloudflare R2 / S3 Storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=clipscheduler-videos
R2_PUBLIC_URL=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@clipscheduler.io

# ==============================================================================
# SOCIAL MEDIA DEVELOPER APP CREDENTIALS (OAUTH)
# Order: YouTube -> Instagram -> Facebook -> Threads -> Twitter/X -> Snapchat -> TikTok (Last)
# Replace YOUR_NGROK_DOMAIN with your permanent ngrok domain
# ==============================================================================

# 1. YouTube Shorts (Google Cloud Console -> APIs & Services -> OAuth 2.0 Client IDs)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://YOUR_NGROK_DOMAIN.ngrok-free.dev/api/v1/accounts/oauth/youtube/callback

# 2. Instagram Reels (Meta for Developers -> App Dashboard -> Instagram API)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR_NGROK_DOMAIN.ngrok-free.dev/api/v1/accounts/oauth/instagram/callback

# 3. Facebook Reels (Meta for Developers -> App Dashboard -> Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://YOUR_NGROK_DOMAIN.ngrok-free.dev/api/v1/accounts/oauth/facebook/callback

# 4. Threads (Meta for Developers -> Threads API)
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=https://YOUR_NGROK_DOMAIN.ngrok-free.dev/api/v1/accounts/oauth/threads/callback

# 5. Twitter / X (Twitter Developer Portal -> Apps -> OAuth 2.0 Client Credentials)
X_API_KEY=
X_API_SECRET=
X_REDIRECT_URI=https://YOUR_NGROK_DOMAIN.ngrok-free.dev/api/v1/accounts/oauth/x/callback

# 6. Snapchat (Snap Kit Developer Portal -> Apps -> Client Credentials)
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=https://YOUR_NGROK_DOMAIN.ngrok-free.dev/api/v1/accounts/oauth/snapchat/callback

# 7. TikTok (TikTok Developer Portal -> Apps -> Client Key & Secret)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR_NGROK_DOMAIN.ngrok-free.dev/api/v1/accounts/oauth/tiktok/callback

# --- AI & Stock APIs ---
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_CANDIDATE_MODEL=gemini-2.0-flash-lite
GEMINI_API_KEY=
PEXELS_API_KEY=
